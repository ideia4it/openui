$n = 3
nums = [4, 1, 3]
root = Stack([Text("Total: " + ($n * 2 + 1)), Metric("Ratio", 10 / 4), Metric("Rest", 10 % 4), Text(!false && $n > 2 ? "big" : "small"), Metric("Second", nums[1]), Metric("Sum", @Sum(nums)), Metric("Max", @Max(nums)), Text("Quote \"q\" and é"), Metric("Negative", -2.5), Button("Docs", null, "secondary", @OpenUrl("https://example.com/docs"))])
