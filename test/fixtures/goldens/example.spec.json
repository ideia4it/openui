{
  "root": "Stack",
  "components": {
    "Stack": {
      "signature": "Stack(children: any[], direction?: \"row\" | \"column\")",
      "description": "Lays out children in a column or a row"
    },
    "Card": {
      "signature": "Card(title: string, children?: any[])",
      "description": "A titled container"
    },
    "Text": {
      "signature": "Text(text: string, variant?: \"body\" | \"heading\")",
      "description": "A run of text"
    },
    "Metric": {
      "signature": "Metric(label: string, value: number, trend?: {direction: \"up\" | \"down\", percent?: number})",
      "description": "A labeled number with an optional trend"
    },
    "LineChart": {
      "signature": "LineChart(labels: string[], series: Series[])",
      "description": "Time series, daily or monthly"
    },
    "Series": {
      "signature": "Series(name: string, values: number[])",
      "description": "One line of a LineChart"
    },
    "Table": {
      "signature": "Table(columns: Col[])",
      "description": "A table built from columns"
    },
    "Col": {
      "signature": "Col(label: string, data?: any[])",
      "description": "One table column: a header and its cell values"
    },
    "Button": {
      "signature": "Button(label: string, action?: ActionExpression, variant?: \"primary\" | \"secondary\", share?: @CopyToClipboard | @OpenUrl)",
      "description": "A clickable button"
    },
    "Form": {
      "signature": "Form(name: string, children: any[])",
      "description": "Groups its inputs under a form name"
    },
    "Input": {
      "signature": "Input(name: string, placeholder?: string, value?: $binding<string>, rules?: {})",
      "description": "A text field"
    },
    "Select": {
      "signature": "Select(name: string, items: SelectItem[], value?: $binding<string>)",
      "description": "A dropdown"
    },
    "SelectItem": {
      "signature": "SelectItem(value: string, label: string)",
      "description": "One option of a Select"
    },
    "Highlight": {
      "signature": "Highlight(content: Card | Metric, enabled?: boolean)",
      "description": "A card or a metric to call attention to"
    }
  },
  "componentGroups": [
    {
      "name": "Layout",
      "components": [
        "Stack",
        "Card"
      ]
    },
    {
      "name": "Charts",
      "components": [
        "LineChart",
        "Series"
      ],
      "notes": [
        "Prefer a chart over a table for series."
      ]
    },
    {
      "name": "Forms",
      "components": [
        "Form",
        "Input",
        "Select",
        "SelectItem",
        "Button"
      ]
    }
  ],
  "functions": {
    "Percent": {
      "signature": "Percent(part: number, total: number) → string",
      "description": "Part over total as a percentage string"
    }
  },
  "actions": {
    "CopyToClipboard": {
      "signature": "CopyToClipboard(text: string)",
      "description": "Copies text to the clipboard"
    }
  },
